# ---------------------------------------------------------------------------
# Inherent OS — environment
# Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# --- Database (Supabase / any Postgres) ------------------------------------
# Supabase hands you TWO connection strings and Prisma needs BOTH.
#
#   DATABASE_URL — the POOLED one (Supavisor, port 6543). Every query the app
#                  runs goes through it. Serverless functions open and drop
#                  connections constantly, which is exactly what a pooler is
#                  for. Keep `pgbouncer=true&connection_limit=1`.
#
#   DIRECT_URL   — the DIRECT one (port 5432). Migrations run DDL and take
#                  advisory locks, neither of which survives transaction-mode
#                  pooling, so they must bypass it.
#
# Find both under Supabase → Project Settings → Database → Connection string.
# Getting this backwards fails unhelpfully: the app works and migrations hang.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# For a plain local Postgres both can be the same:
# DATABASE_URL="postgresql://inherent:inherent@127.0.0.1:5432/inherent_os"
# DIRECT_URL="postgresql://inherent:inherent@127.0.0.1:5432/inherent_os"

# --- Auth -------------------------------------------------------------------
# Signs session cookies. MUST be changed before any real deploy.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-change-me-before-deploying-inherent-os"

# The only email domain allowed to hold an account. Enforced server-side on
# login and on every user create/invite.
ALLOWED_EMAIL_DOMAIN="inherentglobal.com"

# Password given to the seeded founding users. Change it after first login.
SEED_PASSWORD="Inherent2026!"

# ---------------------------------------------------------------------------
# Integrations — optional. The Connections hub reads these to decide whether a
# tool shows as CONNECTED or NEEDS_SETUP. Leave blank to keep it in setup mode.
# ---------------------------------------------------------------------------
GITHUB_ORG="medinaoliva4-tech"
GITHUB_TOKEN=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
JOCKEY_API_KEY=""
HIGGSFIELD_API_KEY=""
ZAPIER_WEBHOOK_URL=""
FIGMA_TOKEN=""
SLACK_WEBHOOK_URL=""
