# ---------------------------------------------------------------------------
# Inherent OS — environment
# Copy to `.env` and fill in. `npm run setup` works with these defaults.
# ---------------------------------------------------------------------------

# Local SQLite store. Swap for a Postgres URL in production
# (also change `provider` in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. MUST be changed before any real deploy.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-change-me-before-deploying-inherent-os"

# The only email domain allowed to hold an account. Enforced server-side on
# login and on every user create/invite.
ALLOWED_EMAIL_DOMAIN="inherentglobal.com"

# Password assigned to the seeded founding users. Change it after first login.
SEED_PASSWORD="Inherent2026!"

# ---------------------------------------------------------------------------
# Integrations — optional. The Connections hub reads these to decide whether a
# tool shows as CONNECTED or NEEDS_SETUP. Leave blank to keep it in setup mode.
# ---------------------------------------------------------------------------
GITHUB_ORG="medinaoliva4-tech"
GITHUB_TOKEN=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
JOCKEY_API_KEY=""
HIGGSFIELD_API_KEY=""
ZAPIER_WEBHOOK_URL=""
FIGMA_TOKEN=""
SLACK_WEBHOOK_URL=""
