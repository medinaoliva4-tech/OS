// ---------------------------------------------------------------------------
// Inherent OS — data model
//
// Two halves that share one spine:
//   CRM   — who we sell to and what that is worth (Account, Contact, Deal)
//   OS    — how the work actually gets made (Project, Task, ContentItem,
//           Asset, Integration)
//
// The spine is `Account`: every client brand is an Account, and every piece of
// work, content, and asset hangs off one. That is what makes "open NAO" show
// the pipeline, the calendar, the pendientes and the asset store in one place.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

  // Supabase gives two connection strings and Prisma needs both:
  //
  //   DATABASE_URL  the pooled one (Supavisor, port 6543). Serverless
  //                 functions open and drop connections constantly, so every
  //                 query the app runs goes through the pooler. The app
  //                 passes this to the driver adapter at runtime (src/lib/db.ts).
  //   DIRECT_URL    the direct one (port 5432). Transaction-mode pooling
  //                 cannot run DDL or advisory locks, so migrations must
  //                 bypass it. The CLI reads this via prisma.config.ts.
  //
  // Getting this wrong fails in the least helpful way: the app works and
  // migrations hang.
  //
  // As of Prisma 7, url/directUrl here are deprecated in favor of
  // prisma.config.ts — see that file for where each connection string is
  // actually wired in.
}

// ===========================================================================
// People & access
// ===========================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  title        String?
  role         String    @default("MEMBER") // OWNER | ADMIN | MEMBER
  passwordHash String
  avatarHue    Int       @default(210) // 0-359, drives the generated avatar
  /// A real photo — data URI or https URL. Falls back to the hue-based
  /// initials tile (Avatar component) when empty.
  avatarUrl    String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  ownedAccounts Account[]     @relation("AccountOwner")
  ownedDeals    Deal[]        @relation("DealOwner")
  ownedProjects Project[]     @relation("ProjectOwner")
  assignedTasks Task[]        @relation("TaskAssignee")
  createdTasks  Task[]        @relation("TaskCreator")
  ownedContent  ContentItem[] @relation("ContentOwner")
  activities    Activity[]
  notes         Note[]
  services      Service[]     @relation("ServiceMembers")
  salary        Salary?
  apiTokens     ApiToken[]
  oauthCodes    OAuthCode[]

  @@index([email])
}

/// A personal access token for the remote MCP connector (src/app/api/mcp).
/// Each user mints their own so Claude.ai / ChatGPT custom connectors can be
/// wired up per person instead of sharing one static secret. The raw token
/// is shown once at creation time and only its SHA-256 hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  /// Last 4 chars of the raw token, for display in the list ("…ab12").
  last4      String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ===========================================================================
// OAuth (for Claude.ai / ChatGPT custom connectors — src/app/oauth/*)
//
// Both platforms only support OAuth 2.1 + PKCE for custom MCP connectors —
// no bearer/API-key field in their UI — so this is the mandatory path, not
// an alternative to the per-user ApiToken above. The token an OAuth exchange
// hands back IS an ApiToken row underneath; these two models exist only to
// get there: who registered as a client, and the one-time code that proves
// a logged-in OS user approved the connection.
// ===========================================================================

/// A client that completed Dynamic Client Registration (RFC 7591). Public
/// clients only (Claude.ai, ChatGPT) — no secret, PKCE carries the security.
model OAuthClient {
  id           String   @id @default(cuid())
  name         String?
  redirectUris String[]
  createdAt    DateTime @default(now())
}

/// A short-lived authorization code from the PKCE flow. Single-use, minutes
/// not days — by the time /oauth/token consumes it, an ApiToken already
/// exists and this row is disposable.
model OAuthCode {
  id                  String    @id @default(cuid())
  code                String    @unique
  clientId            String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId])
}

// ===========================================================================
// CRM
// ===========================================================================

/// A client brand or an internal entity. The spine of the whole OS.
model Account {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  kind     String  @default("CLIENT") // CLIENT | PROSPECT | PARTNER | INTERNAL
  status   String  @default("ACTIVE") // ACTIVE | ONBOARDING | PAUSED | CHURNED
  tier     String  @default("GROWTH") // FOUNDING | GROWTH | ENTERPRISE
  industry String?
  website  String?
  summary  String?
  /// Hex accent for the brand chip across the OS.
  brandHex String  @default("#5EEAD4")
  /// The client's own logo. Either a data URI (uploaded during onboarding) or
  /// an https URL. Falls back to the initials tile when empty.
  logoUrl  String?

  // Retainer economics
  mrr      Int    @default(0) // stored in whole currency units
  currency String @default("USD")

  // Where this brand's work physically lives. These make the OS a real hub
  // instead of another place to re-type links.
  githubRepo      String? // owner/repo — the content-system folder in git
  githubPath      String? @default("/")
  driveFolderUrl  String?
  jockeyWorkspace String?
  figmaFileUrl    String?
  notionUrl       String?

  ownerId String?
  owner   User?   @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  startedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      Contact[]
  deals         Deal[]
  projects      Project[]
  tasks         Task[]
  contentItems  ContentItem[]
  assets        Asset[]
  guidelines    Guideline[]
  notes         Note[]
  pipelineSteps ContentPipelineStep[]

  @@index([slug])
  @@index([status])
}

model Contact {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean @default(false)
  linkedin  String?
  notes     String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  /// LEAD | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  stage             String    @default("LEAD")
  value             Int       @default(0)
  currency          String    @default("USD")
  probability       Int       @default(20)
  source            String? // REFERRAL | INBOUND | OUTBOUND | NETWORK | EXISTING
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  notes             String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([stage])
}

// ===========================================================================
// Delivery
// ===========================================================================

model Project {
  id        String    @id @default(cuid())
  name      String
  summary   String?
  /// PLANNING | ACTIVE | BLOCKED | DONE
  status    String    @default("ACTIVE")
  startDate DateTime?
  dueDate   DateTime?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([accountId])
}

/// The pendientes board. One row per thing somebody actually has to do.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// BACKLOG | TODO | IN_PROGRESS | BLOCKED | REVIEW | DONE
  status      String    @default("TODO")
  /// LOW | MEDIUM | HIGH | URGENT
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?
  /// Comma-separated labels, e.g. "guidelines,jockey".
  labels      String    @default("")
  /// Which stage of the content system this task advances, when it maps to one.
  pipelineKey String?
  position    Int       @default(0)

  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([assigneeId])
}

// ===========================================================================
// Content system
// ===========================================================================

/// One planned or published piece. Drives the per-brand calendar.
model ContentItem {
  id           String    @id @default(cuid())
  title        String
  caption      String?
  /// REEL | POST | CAROUSEL | STORY | VIDEO | UGC | STILL
  format       String    @default("POST")
  /// INSTAGRAM | TIKTOK | YOUTUBE | LINKEDIN | WEB | EMAIL
  channel      String    @default("INSTAGRAM")
  /// IDEA | BRIEF | GENERATING | REVIEW | APPROVED | SCHEDULED | PUBLISHED
  stage        String    @default("IDEA")
  scheduledFor DateTime?
  publishedAt  DateTime?
  /// Where the generated asset came from: JOCKEY | HIGGSFIELD | SHOT | EXTERNAL
  origin       String?
  hook         String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?   @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@index([accountId])
  @@index([scheduledFor])
  @@index([stage])
}

/// A file that exists somewhere real — Drive, Jockey, Higgsfield, GitHub.
model Asset {
  id        String  @id @default(cuid())
  name      String
  /// IMAGE | VIDEO | DOC | GUIDELINE | AUDIO | OTHER
  kind      String  @default("IMAGE")
  /// RAW | GENERATED | APPROVED | FINAL | ARCHIVED
  stage     String  @default("RAW")
  /// DRIVE | JOCKEY | HIGGSFIELD | GITHUB | FIGMA | LOCAL
  source    String  @default("DRIVE")
  url       String?
  /// Path inside the brand's content-system folder.
  path      String?
  mimeType  String?
  sizeBytes Int?
  notes     String?

  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([stage])
}

/// Brand guidelines tracked section by section, so "terminar guidelines" has a
/// number attached to it instead of a feeling.
model Guideline {
  id        String  @id @default(cuid())
  section   String
  /// MISSING | DRAFT | REVIEW | DONE
  status    String  @default("MISSING")
  content   String?
  sourceUrl String?
  position  Int     @default(0)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

/// A checkpoint in the Drive -> Jockey -> Higgsfield -> Approved -> GitHub ->
/// Design -> Schedule chain, tracked per brand. This is the pendientes list
/// turned into a machine you can look at.
model ContentPipelineStep {
  id        String  @id @default(cuid())
  /// Stable identifier for the stage, e.g. "jockey_ingest".
  key       String
  label     String
  /// NOT_STARTED | IN_PROGRESS | BLOCKED | DONE
  status    String  @default("NOT_STARTED")
  position  Int     @default(0)
  /// Which integration owns this hop.
  toolKey   String?
  note      String?
  updatedBy String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, key])
  @@index([accountId])
}

// ===========================================================================
// Connections & activity
// ===========================================================================

/// A tool we depend on. The Connections hub is the single answer to
/// "is the pipe between Drive and Jockey actually working right now?"
model Integration {
  id         String    @id @default(cuid())
  key        String    @unique // github, drive, jockey, higgsfield, zapier, cowork...
  name       String
  /// SOURCE | KNOWLEDGE | GENERATION | AUTOMATION | DELIVERY | COMMS | DESIGN
  category   String    @default("AUTOMATION")
  /// CONNECTED | NEEDS_SETUP | DEGRADED | ERROR | DISABLED
  status     String    @default("NEEDS_SETUP")
  summary    String?
  /// What this tool is responsible for in our chain, in one line.
  role       String?
  docsUrl    String?
  /// Name of the env var that switches this on. Never the secret itself.
  envKey     String?
  /// JSON blob of non-secret config (workspace ids, folder names, ...).
  config     String    @default("{}")
  lastSyncAt DateTime?
  lastError  String?
  position   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncEvents SyncEvent[]

  @@index([status])
}

model SyncEvent {
  id      String  @id @default(cuid())
  /// OK | WARN | ERROR
  level   String  @default("OK")
  message String
  detail  String?

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([integrationId])
}

/// Append-only feed. Every mutation in the OS writes one of these.
model Activity {
  id         String @id @default(cuid())
  /// created | updated | moved | completed | connected | commented
  verb       String
  entityType String
  entityId   String
  summary    String
  meta       String @default("{}")

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Note {
  id         String @id @default(cuid())
  body       String
  entityType String
  entityId   String

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
}

// ===========================================================================
// Services — the lines of work the agency sells (Content Creation, Graphic
// Design, Photography...), each with its own team. Not money — visible to
// everyone, unlike the Finance models below.
// ===========================================================================

model Service {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  /// Hex accent, same idea as Account.brandHex.
  color       String  @default("#5EEAD4")
  /// ACTIVE | PAUSED
  status      String  @default("ACTIVE")
  position    Int     @default(0)

  members User[] @relation("ServiceMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ===========================================================================
// Finance — ADMIN+ only (see canViewFinancials in src/lib/policy.ts), same
// gate as MRR and deal values. Deliberately three separate, simple models
// rather than one generic "transaction" table: Costs, Salaries and
// Reinvestments are different questions with different shapes, and P&L is
// computed live from these plus revenue rather than stored anywhere.
// ===========================================================================

/// A recurring or one-off business cost — tools, infra, office, whatever
/// isn't a person's pay (that's Salary).
model Cost {
  id         String    @id @default(cuid())
  name       String
  /// TOOLS | INFRA | OFFICE | MARKETING | LEGAL | OTHER
  category   String    @default("OTHER")
  amount     Int
  currency   String    @default("USD")
  /// ONE_TIME | MONTHLY | YEARLY
  recurrence String    @default("MONTHLY")
  startDate  DateTime  @default(now())
  endDate    DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recurrence])
}

/// A team member's current pay. Deliberately one row per person — "what do
/// we pay them now", not a full raise history.
model Salary {
  id        String   @id @default(cuid())
  amount    Int
  currency  String   @default("USD")
  /// MONTHLY | YEARLY
  cadence   String   @default("MONTHLY")
  startDate DateTime @default(now())
  notes     String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A log entry of money put back into the business — equipment, a hire,
/// tooling — anything that isn't a recurring Cost.
model Reinvestment {
  id       String   @id @default(cuid())
  title    String
  amount   Int
  currency String   @default("USD")
  date     DateTime @default(now())
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
